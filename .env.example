HMB_DATABASE_PATH=./data/hmb.sqlite
HMB_ORIGIN=http://localhost:3000
# Supply initial accounts via the seed command; no default production credentials.
# Use HTTPS and set HMB_SECURE_COOKIES=1 behind your production proxy.
HMB_SECURE_COOKIES=0
# Set to 1 only on the public production deployment. Preview stays noindex.
HMB_PUBLIC_SITE=0
